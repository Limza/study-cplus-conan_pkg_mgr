		<Import Condition="'$(Configuration)' == 'Debug' And '$(Platform)' == 'x64'" Project="conantoolchain_debug_x64.props"/>
	</ImportGroup>
	<PropertyGroup Label="ConanPackageInfo">
		<ConanPackageName/>
		<ConanPackageVersion/>
	</PropertyGroup>
</Project>